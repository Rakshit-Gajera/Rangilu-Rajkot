# Cloudflare Pages headers (copied into game/dist by Vite).
# World packs are gzip files the game inflates itself: never let them be served with Content-Encoding.
/world/*
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
/world/*.gz
  Content-Type: application/octet-stream
/assets/*
  Cache-Control: public, max-age=31536000, immutable
